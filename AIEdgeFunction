
import { withSupabase } from "npm:@supabase/server@1";

export default {
  fetch: withSupabase(
    { auth: "user" },
    async (req) => {
      try {
        // 1. Read the message from FlutterFlow
        const body = await req.json();
        const message = body.message;

        // 2. Validate the message
        if (
          typeof message !== "string" ||
          message.trim().length === 0 ||
          message.length > 2000
        ) {
          return Response.json(
            { error: "Please enter a valid message" },
            { status: 400 }
          );
        }

        // 3. Read our secret API key
        const groqKey = Deno.env.get("GROQ_API_KEY");

        if (!groqKey) {
          return Response.json(
            { error: "Groq API key is missing" },
            { status: 500 }
          );
        }

        // 4. The AI's instructions
        // Students can customize this during DIY!
        const systemPrompt =
          "You are a helpful AI assistant. " +
          "Answer questions clearly and simply.";

        // 5. Send the question to Groq
        const response = await fetch(
          "https://api.groq.com/openai/v1/chat/completions",
          {
            method: "POST",
            headers: {
              "Authorization": `Bearer ${groqKey}`,
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              model: "openai/gpt-oss-20b",
              messages: [
                {
                  role: "system",
                  content: systemPrompt
                },
                {
                  role: "user",
                  content: message.trim()
                }
              ],
              reasoning_effort: "low",
              max_completion_tokens: 1024
            })
          }
        );

        // 6. Handle an unsuccessful Groq request
        if (!response.ok) {
          console.error(
            "Groq error:",
            response.status,
            await response.text()
          );

          return Response.json(
            { error: "AI request failed" },
            {
              status: response.status === 429 ? 429 : 502
            }
          );
        }

        // 7. Read Groq's generated response
        const data = await response.json();
        const reply =
          data.choices?.[0]?.message?.content;

        if (typeof reply !== "string" || !reply.trim()) {
          return Response.json(
            { error: "AI returned no answer" },
            { status: 502 }
          );
        }

        // 8. Send the reply back to FlutterFlow
        return Response.json({
          reply: reply
        });

      } catch (error) {
        console.error("Function error:", error);

        return Response.json(
          { error: "Something went wrong" },
          { status: 500 }
        );
      }
    }
  )
};
